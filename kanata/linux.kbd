;; Kanata config — https://github.com/jtroo/kanata/blob/main/docs/config.adoc
(defcfg
  process-unmapped-keys yes
  ;; "any" also grabs pure mice (keyboard-mice skips them), needed for mbck/mfwd
  linux-device-detect-mode any
  ;; don't grab audio jack sensors / power buttons that "any" would pick up
  linux-dev-names-exclude (
    "Power Button"
    "HD-Audio Generic Front Headphone"
    "HD-Audio Generic Line Out Side"
    "HD-Audio Generic Line Out CLFE"
    "HD-Audio Generic Line Out Surround"
    "HD-Audio Generic Line Out Front"
    "HD-Audio Generic Line"
    "HD-Audio Generic Front Mic"
    "HD-Audio Generic Rear Mic"
    "HDA ATI HDMI HDMI/DP,pcm=3"
    "HDA ATI HDMI HDMI/DP,pcm=7"
    "HDA ATI HDMI HDMI/DP,pcm=8"
    "HDA ATI HDMI HDMI/DP,pcm=9"
    "HDA ATI HDMI HDMI/DP,pcm=10"
    "HDA ATI HDMI HDMI/DP,pcm=11"
  )
)

(defalias
  ;; hold scrolllock for the slk layer; scrolllock alone does nothing
  slk (layer-while-held slk)
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  slck del
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
  mbck mfwd
  pgup pgdn
)

(deflayer base
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  @slk del
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
  C-S-tab C-tab
  pgup pgdn
)

;; while scrolllock held: esc => ` (add shift for ~), delete => printscreen,
;; 1..0 - = => f1..f12, pgup => home, pgdn => end,
;; i => insert, p => printscreen
(deflayer slk
  grv  _    _    _    _    _    _    _    _    _    _    _    _    _    prnt
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    _    _    _    _    _    _    _    ins  _    prnt _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
  _    _
  home end
)
